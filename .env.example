# Copy to `.env` in your project root before running `adsb serve`.
# Variables here are loaded into the process environment at server startup.
# Existing process env vars win — these are fallbacks, not overrides.

# Mapbox access token used by the bundled map UI. Get one at:
# https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=pk.your_token_here
