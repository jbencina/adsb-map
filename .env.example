# Copy to `.env` in the directory you run `adsb start frontend` from.
# This file is for secrets only. Everything else (ports, paths, data source,
# backend URL) is a CLI argument -- see `adsb <command> --help`.
# Existing process env vars win over values here.

# Mapbox access token used by the map UI. Get one at:
# https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=pk.your_token_here
